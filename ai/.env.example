# Copia este archivo a .env (no se sube a git) o exporta las variables en tu terminal.

# gemini | openai | azure | fake
LLM_PROVIDER=fake

# Gemini: gratis con una clave de https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI (de pago)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI (de pago): los "modelos" son los nombres de tus deployments
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
